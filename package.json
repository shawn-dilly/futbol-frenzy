{
  "name": "futbol-frenzy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "e2e": "playwright test",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
